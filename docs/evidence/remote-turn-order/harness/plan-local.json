{
	"steps": [
		{ "op": "nav", "path": "/chat" },
		{
			"op": "waitFor",
			"selector": "[data-tour-tag=\"chat-input-textarea\"] textarea",
			"timeoutMs": 90000
		},
		{ "op": "wait", "ms": 3000 },
		{ "op": "shot", "name": "00-newdraft" },
		{
			"op": "eval",
			"js": "JSON.stringify({chip: !!document.querySelector('[data-device-chip]'), chipText: document.querySelector('[data-device-chip]')?.innerText, hash: location.hash})"
		},
		{
			"op": "send",
			"text": "Run `sleep 5` in a bash tool call first, then reply with just the word ready. (Automated turn-order check, agent session 53e0a8a53bc5 — no action needed.)"
		},
		{
			"op": "watch",
			"prefix": "f",
			"everyMs": 300,
			"shotEveryMs": 2500,
			"totalMs": 60000
		},
		{ "op": "rows", "note": "final" },
		{ "op": "shot", "name": "99-final" }
	]
}
