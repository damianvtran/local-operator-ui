+
+/*
+ * THE BEFORE ARM OF PR #1259 (uncommitted scratch story).
+ *
+ * These stories render the SAME 440px docked preview surface as the PR's
+ * `PreviewInline*` stories, from base `c9bbfe25f0`'s code: `EditableField` and
+ * `TagsInputChips`, the labelled/bordered controls with the absolutely
+ * positioned pencil and Clear controls, and the inert media viewer. The ids are
+ * deliberately the same as the after arm's for the states that existed, so the
+ * capture tuples differ only in their selectors; `PreviewMediaInert` is the one
+ * new id, because the lightbox did not exist here to photograph.
+ *
+ * Nothing in this block is committed: it exists so the before frames come from
+ * the shipped before code rather than from a re-creation of it.
+ */
+const PreviewBeforeFromQuery: FC<{ row: DesktopLibraryAsset }> = ({ row }) => {
+	const detail = useLibraryAsset(row.id, true);
+	return (
+		<div className="flex h-screen justify-end bg-canvas">
+			<div className="flex h-full w-[440px] min-w-0 flex-col">
+				<LibraryPreview
+					asset={detail.data ?? row}
+					nowMs={NOW}
+					onClose={() => undefined}
+					onOpenConversation={() => undefined}
+					onFilterSession={() => undefined}
+					onAsk={() => undefined}
+					onToggleFavorite={() => undefined}
+					composerFocusSignal={0}
+					focusRequest={null}
+				/>
+			</div>
+		</div>
+	);
+};
+
+const previewBeforePane = (row: DesktopLibraryAsset) => {
+	stub = {
+		rows: [row, ...ROWS.filter((item) => item.id !== row.id)],
+		detail: row,
+		hang: false,
+		building: false,
+		failList: null,
+		media: "text",
+		linkedChat: false,
+	};
+	install();
+	return <PreviewBeforeFromQuery row={row} />;
+};
+
+const beforeControl = (label: string) => {
+	const node = document.querySelector<HTMLButtonElement>(
+		`button[aria-label="${label}"]`,
+	);
+	if (!node) throw new Error(`the ${label} control is not mounted`);
+	return node;
+};
+
+export const PreviewInlinePopulated: Story = {
+	render: () => previewBeforePane(ROWS[2]),
+};
+
+export const PreviewInlineNameHover: Story = {
