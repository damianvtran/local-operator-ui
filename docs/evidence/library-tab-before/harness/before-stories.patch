+};
+
+export const PreviewInlineNameEditing: Story = {
+	render: () => previewBeforePane(ROWS[2]),
+	play: async () => {
+		const user = userEvent.setup();
+		await user.click(await waitFor(() => beforeControl("Edit Name")));
+		await waitFor(() =>
+			expect(document.querySelector("header > div:first-child input")).toBeTruthy(),
+		);
+	},
+};
+
+export const PreviewInlineNameEscape: Story = {
+	render: () => previewBeforePane(ROWS[2]),
+	play: async () => {
+		const user = userEvent.setup();
+		await user.click(await waitFor(() => beforeControl("Edit Name")));
+		const input = await waitFor(() => {
+			const found = document.querySelector<HTMLInputElement>(
+				"header > div:first-child input",
+			);
+			if (!found) throw new Error("the name editor did not open");
+			return found;
+		});
+		await user.type(input, "changed");
+		await user.keyboard("{Escape}");
+		await waitFor(() =>
+			expect(document.querySelector("header > div:first-child input")).toBeNull(),
+		);
+		await waitFor(() =>
+			expect(document.body.textContent).toContain("March invoices"),
+		);
+	},
+};
+
