+ rows.push(message("byok-user","user",[{text:"Generate a 0.5s door creak through the configured ElevenLabs key."}]));
+ rows.push(message("byok-call","assistant",[],{tool_calls:[{tool_call_id:"release-byok-call",tool_name:"generate_sound_effect",arguments:byok.args}]}));
+ rows.push(message("byok-result","tool",byok.result.content,{tool_call_id:"release-byok-call",tool_name:"generate_sound_effect",provider_payload:{details:byok.result.details}}));
