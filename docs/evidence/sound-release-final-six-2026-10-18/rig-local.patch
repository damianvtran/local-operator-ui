+  writeFileSync(join(attachments,`${digest}.json`),JSON.stringify({digest,mime_type:"audio/mpeg",bytes:bytes.length,duration_s:a.duration_s,peaks:a.peaks}));
+  writeFileSync(join(attachments,`${digest}.peaks.json`),JSON.stringify({version:1,bars:240,peaks:a.peaks}));
+  const call=`sounds-call-${index+1}`;
+  rows.push(message(`user-${index}`,"user",[{text:a.title}]));
+  rows.push(message(`call-${index}`,"assistant",[],{tool_calls:[{tool_call_id:call,tool_name:a.tool,arguments:index?{prompt:a.title,duration_s:.5}:{text:a.title}}]}));
+  rows.push(message(`result-${index}`,"tool",[{text:`Generated ${index?"sound effect":"voiceover"} (${a.duration_s}s). Cost $0.0020 (billed). Request ${a.request_id}.`},{kind:"audio",content_type:"audio/mpeg",attachment:digest,mime_type:"audio/mpeg",name:`${a.title}.mp3`,duration_s:a.duration_s}],{tool_call_id:call,tool_name:a.tool}));
+  rows.push(message(`answer-${index}`,"assistant",[{text:"Attached the generated audio."}]));
+ }
+ const refusal=JSON.parse(readFileSync(process.env.SOUNDS_RELEASE_REFUSAL,"utf8"));
+ rows.push(message("refusal-user","user",[{text:"Generate a door creak without specifying duration."}]));
+ rows.push(message("refusal-call","assistant",[],{tool_calls:[{tool_call_id:"sounds-refusal",tool_name:"generate_sound_effect",arguments:{prompt:"a door creak",model:"radient/sound-effects"}}]}));
+ rows.push(message("refusal-result","tool",[{text:JSON.stringify(refusal,null,2)}],{tool_call_id:"sounds-refusal",tool_name:"generate_sound_effect",is_error:true,isError:true,provider_payload:{details:{error_type:"invalid_arguments"}}}));
+ rows.push(message("refusal-answer","assistant",[{text:"The server refused auto-duration because it cannot quote the request."}]));
+ const byok=JSON.parse(readFileSync(process.env.SOUNDS_RELEASE_BYOK,"utf8"));
+ const block=byok.result.content.find(c=>c.kind==="audio");
+ const store=process.env.SOUNDS_RELEASE_BYOK_STORE;
+ for(const ext of ["bin","json","peaks.json"]) { const path=join(store,`${block.attachment}.${ext}`); if(existsSync(path)) writeFileSync(join(attachments,`${block.attachment}.${ext}`),readFileSync(path)); }
+ rows.push(message("byok-user","user",[{text:"Generate a 0.5s door creak through the configured ElevenLabs key."}]));
+ rows.push(message("byok-call","assistant",[],{tool_calls:[{tool_call_id:"release-byok-call",tool_name:"generate_sound_effect",arguments:byok.args}]}));
+ rows.push(message("byok-result","tool",byok.result.content,{tool_call_id:"release-byok-call",tool_name:"generate_sound_effect",provider_payload:{details:byok.result.details}}));
+ rows.push(message("byok-answer","assistant",[{text:byok.approval}]));
+ rows.push(message("later-user","user",[{text:"Play the earlier voiceover while keeping this later conversation turn visible."}]));
+ rows.push(message("later-answer","assistant",[{text:"The earlier artifact stays playable in the transcript."}]));
+ const dir=join(root,"sessions",SOUNDS_SESSION);mkdirSync(dir,{recursive:true});writeFileSync(join(dir,"transcript.jsonl"),rows.map(r=>JSON.stringify(r)).join("\n")+"\n");
+ return {digest:assets[0].sha256.slice(0,32),sessionId:SOUNDS_SESSION,bytes:26374,releaseReplay:true};
+}
