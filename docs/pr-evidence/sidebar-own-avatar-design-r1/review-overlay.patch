+/* Focus: a script focus with no prior pointer input matches :focus-visible in Chromium. */
+const FocusRow: FC<{ expanded?: boolean; face?: boolean }> = ({
+	expanded = true,
+	face = true,
+}) => {
+	useLayoutEffect(() => {
+		const t = window.setTimeout(() => {
+			document
+				.querySelector<HTMLElement>("[data-review-focus] button")
+				?.focus();
+		}, 1500);
+		return () => window.clearTimeout(t);
+	}, []);
+	return (
+		<span className="contents" data-review-focus>
+			<Row state="photo" face={face} expanded={expanded} />
+		</span>
+	);
+};
+export const ReviewFaceFocus: Story = {
+	args: { state: "photo" },
+	render: () => <FocusRow />,
+};
+export const ReviewFaceFocusCollapsed: Story = {
+	args: { state: "photo" },
+	render: () => <FocusRow expanded={false} />,
+};
+/* Hover: the row's only hover paint is `hover:bg-row-hover`; apply that same
+   utility so the frame shows the hovered ground without a real pointer. */
+const HoverRow: FC<{ expanded?: boolean; state?: RowState; face?: boolean }> = ({
+	expanded = true,
+	state = "photo",
+	face = true,
+}) => {
+	useLayoutEffect(() => {
+		const t = window.setInterval(() => {
+			document
+				.querySelector<HTMLElement>("[data-review-hover] button")
+				?.classList.add("bg-row-hover");
+		}, 500);
+		return () => window.clearInterval(t);
+	}, []);
+	return (
+		<span className="contents" data-review-hover>
+			<Row state={state} face={face} expanded={expanded} />
+		</span>
+	);
+};
