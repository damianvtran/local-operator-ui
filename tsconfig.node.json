{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/i18n/**/*"],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    // TypeScript 7 removed `moduleResolution: "node"` (node10), which the
    // @electron-toolkit base config still sets. `bundler` is the mode that
    // matches how these files are actually consumed: electron-vite runs main
    // and preload through rollup, so extensionless imports and package
    // `exports` are both legitimate here.
    "moduleResolution": "bundler",
    "noEmit": true,
    // Composite projects write build info even with noEmit. Keep that mutable
    // cache in this worktree, never in node_modules borrowed from another one.
    "tsBuildInfoFile": "./.cache/typecheck/node.tsbuildinfo",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
