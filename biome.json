{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"maxSize": 3145728,
		"ignore": [
			"dist/**",
			"out/**",
			"node_modules/**",
			"src/renderer/src/styles/themes.generated.css",
			"src/main/browser/vendor/**",
			"src/main/browser/actions/geometry-sources.gen.ts",
			"scripts/fixtures/condense.parity.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "warn"
			},
			"performance": {
				"noReExportAll": "warn",
				"useTopLevelRegex": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"json": {
		"formatter": {
			"enabled": true
		}
	}
}
