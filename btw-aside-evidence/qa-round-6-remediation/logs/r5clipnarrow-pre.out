    {
      "at": "2026-09-25T03:28:54.750Z",
      "url": "/v1/desktop/sessions/b8a5d9b96cb6/asides",
      "asideId": "adce1edb-65b2-452c-9f60-b2742e11d1ea",
      "continues": "3f5dc4dd-e210-4151-9de2-5791a8b80214",
      "questionHead": "q35e answered before the owner drops it",
      "text": "q35e answered before the owner drops it",
      "carriedSubscriptionField": true,
      "subscriptionId": "349bd12786a8430dafb8b21d90e71312",
      "status": 200,
      "response": "{\"status\":200,\"message\":\"Desktop session result.\",\"result\":{\"data\":{\"aside_id\":\"adce1edb-65b2-452c-9f60-b2742e11d1ea\",\"text\":\"Transport failures and owner **5xx** responses, per provider, inside a moving window.\\n\\n- each transport failure spends one\\n- each owner 5xx spends one\\n- a retry that succeeds resets the window\\n\\nA **4xx** never spends it: the request was wrong, not the provider.\",\"off_record\":true},\"replayed\":false}}"
    },
    {
      "at": "2026-09-25T03:29:00.173Z",
      "url": "/v1/desktop/sessions/b8a5d9b96cb6/asides",
      "asideId": "0550f705-2dfa-484d-aa6f-9ec6fd97a826",
      "continues": "adce1edb-65b2-452c-9f60-b2742e11d1ea",
      "questionHead": "q35e follow-up after the owner dropped the prefix",
      "text": "q35e follow-up after the owner dropped the prefix",
      "carriedSubscriptionField": true,
      "subscriptionId": "349bd12786a8430dafb8b21d90e71312",
      "status": 409,
      "response": "{\"detail\":\"This aside is no longer available\"}"
    },
    {
      "at": "2026-09-25T03:29:03.772Z",
      "url": "/v1/desktop/sessions/b8a5d9b96cb6/asides",
      "asideId": "185e7d73-01bf-45e0-84e4-bc6ba3aca0e4",
      "continues": null,
      "questionHead": "LONGANSWER: q36 long first answer",
      "text": "LONGANSWER: q36 long first answer",
      "carriedSubscriptionField": true,
      "subscriptionId": "349bd12786a8430dafb8b21d90e71312",
      "status": 200,
      "response": "{\"status\":200,\"message\":\"Desktop session result.\",\"result\":{\"data\":{\"aside_id\":\"185e7d73-01bf-45e0-84e4-bc6ba3aca0e4\",\"text\":\"The retry budget is a per-provider allowance, and it is spent only by failures that a second attempt could plausibly fix. A dropped connection, a reset stream, a timeout before the first byte and an owner 5xx each spend one unit; a 4xx spends nothing, because the request itself was refused and sending it again would be refused again. The window moves, so an allowance spent an hour ago is back by now, and a burst of failures inside a single minute exhausts it quickly on "
    },
