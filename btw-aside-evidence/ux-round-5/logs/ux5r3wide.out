    {
      "at": "2026-09-25T13:23:08.683Z",
      "url": "/v1/desktop/sessions/c4dfee86da2a/asides",
      "asideId": "3d09d627-65f8-4e3b-bd9d-a1c03af9440d",
      "continues": null,
      "questionHead": "LONGANSWER U3 an aside while the agent works",
      "text": "LONGANSWER U3 an aside while the agent works",
      "carriedSubscriptionField": true,
      "subscriptionId": "88138031f1104b66ae7e5258f78a0b2d",
      "status": 200,
      "response": "{\"status\":200,\"message\":\"Desktop session result.\",\"result\":{\"data\":{\"aside_id\":\"3d09d627-65f8-4e3b-bd9d-a1c03af9440d\",\"text\":\"The retry budget is a per-provider allowance, and it is spent only by failures that a second attempt could plausibly fix. A dropped connection, a reset stream, a timeout before the first byte and an owner 5xx each spend one unit; a 4xx spends nothing, because the request itself was refused and sending it again would be refused again. The window moves, so an allowance spent an hour ago is back by now, and a burst of failures inside a single minute exhausts it quickly on "
    },
    {
      "at": "2026-09-25T13:23:17.831Z",
      "url": "/v1/desktop/sessions/c4dfee86da2a/asides",
      "asideId": "0621cc67-ced1-4a8e-8bb9-a6b3d88758d5",
      "continues": null,
