    {
      "at": "2026-09-25T13:52:16.285Z",
      "url": "/v1/desktop/sessions/e1f123bf5f16/asides",
      "asideId": "0bbd4c5d-6e63-4d8f-bed2-e9bf214fe5b0",
      "continues": null,
      "questionHead": "LONGANSWER U3 an aside while the agent works",
      "text": "LONGANSWER U3 an aside while the agent works",
      "carriedSubscriptionField": true,
      "subscriptionId": "265691b98da94b328ab55a4b0d0ffa69",
      "status": 200,
      "response": "{\"status\":200,\"message\":\"Desktop session result.\",\"result\":{\"data\":{\"aside_id\":\"0bbd4c5d-6e63-4d8f-bed2-e9bf214fe5b0\",\"text\":\"The retry budget is a per-provider allowance, and it is spent only by failures that a second attempt could plausibly fix. A dropped connection, a reset stream, a timeout before the first byte and an owner 5xx each spend one unit; a 4xx spends nothing, because the request itself was refused and sending it again would be refused again. The window moves, so an allowance spent an hour ago is back by now, and a burst of failures inside a single minute exhausts it quickly on "
    },
    {
      "at": "2026-09-25T13:52:32.358Z",
      "url": "/v1/desktop/sessions/e1f123bf5f16/asides",
      "asideId": "449249bf-cd1b-4fff-b519-c5c8992649e5",
      "continues": null,
