    {
      "at": "2026-09-25T13:32:28.896Z",
      "url": "/v1/desktop/sessions/c26dfd9f3ddf/asides",
      "asideId": "6aa84ea2-225a-49bf-857d-591b5fb64d44",
      "continues": "b27f1192-f060-472c-a8bb-ce89e5b45027",
      "questionHead": "LONGANSWER UN5d the answer the composer types over",
      "text": "LONGANSWER UN5d the answer the composer types over",
      "carriedSubscriptionField": true,
      "subscriptionId": "72884c9fa0c8462aa44aa1ad82d521f4",
      "status": 200,
      "response": "{\"status\":200,\"message\":\"Desktop session result.\",\"result\":{\"data\":{\"aside_id\":\"6aa84ea2-225a-49bf-857d-591b5fb64d44\",\"text\":\"The retry budget is a per-provider allowance, and it is spent only by failures that a second attempt could plausibly fix. A dropped connection, a reset stream, a timeout before the first byte and an owner 5xx each spend one unit; a 4xx spends nothing, because the request itself was refused and sending it again would be refused again. The window moves, so an allowance spent an hour ago is back by now, and a burst of failures inside a single minute exhausts it quickly on "
    },
