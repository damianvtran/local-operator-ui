# Local Operator UI Build Environment Variables
# Copy this file to .env.build and fill in the values for your environment

# GitHub Token (for publishing releases)
GH_TOKEN=your_github_token

# macOS notarization: an App Store Connect API key (what the release workflows use)
APPLE_API_KEY=/path/to/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=XXXXXXXXXX
APPLE_API_ISSUER=00000000-0000-0000-0000-000000000000
APPLE_TEAM_ID=your_team_id
# Local-only fallback when no API key is set; CI no longer uses it:
# APPLE_ID=your_apple_id@example.com
# APPLE_ID_PASSWORD=your_app_specific_password

# Code Signing (a Developer ID Application identity)
# Base64-encoded certificate
CSC_CONTENT="base64-mulitline-encoded-certificate"
CSC_KEY_PASSWORD=your_certificate_password

# Build Configuration
# Uncomment to enable notarization for macOS builds
# NOTARIZE=true

# Uncomment to skip specific platform builds
# SKIP_MAC=true
# SKIP_WINDOWS=true
# SKIP_LINUX=true

# Uncomment to enable debug mode for electron-builder
# DEBUG=electron-builder
