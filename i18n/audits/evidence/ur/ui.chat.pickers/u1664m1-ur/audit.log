import fs from 'node:fs';
import assert from 'node:assert/strict';
import {parse,TYPE} from '@formatjs/icu-messageformat-parser';
import {messageArguments} from './scripts/i18n/generate.mjs';
import {namespaceGap} from './scripts/i18n/context-parity.mjs';
const ns='ui.chat.pickers'; const load=l=>JSON.parse(fs.readFileSync(`src/i18n/catalogues/${l}/${ns}.json`,'utf8'));
const en=load('en'),ur=load('ur'),ctx=JSON.parse(fs.readFileSync(`src/i18n/catalogues/en/${ns}.context.json`,'utf8'));
assert.deepEqual(Object.keys(en).sort(),Object.keys(ur).sort());assert.deepEqual(Object.keys(en).sort(),Object.keys(ctx).sort());
const gap=namespaceGap(ns);assert.equal(gap.uncovered.length,0);assert.equal(gap.orphaned.length,0);
const failures=[],counts={keys:0,plural:0,select:0,tags:0,code_spans:0,manual_bidi_controls:0};
const signature=(nodes,locale)=>nodes.filter(n=>n.type!==TYPE.literal&&n.type!==TYPE.pound).map(n=>{
 const out={type:n.type,value:n.value};
 if(n.style)out.style=n.style;
 if(n.options){out.options=Object.fromEntries(Object.entries(n.options).sort().map(([k,v])=>[k,signature(v.value,locale)]));
 if(locale==='ur'&&n.type===TYPE.plural){counts.plural++;const required=new Intl.PluralRules('ur',{type:n.pluralType}).resolvedOptions().pluralCategories;for(const cat of required)assert.ok(n.options[cat],`missing CLDR ${cat}`);}
 if(locale==='ur'&&n.type===TYPE.select)counts.select++;
 }
 if(n.children){out.children=signature(n.children,locale);if(locale==='ur')counts.tags++;}
 if(n.type===TYPE.plural){out.offset=n.offset;out.pluralType=n.pluralType;}
 return out;
}).sort((a,b)=>JSON.stringify(a).localeCompare(JSON.stringify(b)));
for(const key of Object.keys(en)){
 counts.keys++;
 try{
 assert.deepEqual(messageArguments(en[key]).sort(),messageArguments(ur[key]).sort(),'repo messageArguments parity');
 assert.deepEqual(signature(parse(en[key]),'en'),signature(parse(ur[key]),'ur'),'ICU structure/type/style/tag parity');
 const code=s=>[...s.matchAll(/`[^`]*`/g)].map(m=>m[0]).sort(); assert.deepEqual(code(en[key]),code(ur[key]),'backtick tokens');counts.code_spans+=code(en[key]).length;
 const bidi=[...ur[key]].filter(c=>/[\u061c\u200e\u200f\u202a-\u202e\u2066-\u2069]/u.test(c));counts.manual_bidi_controls+=bidi.length;assert.equal(bidi.length,0,'manual bidi controls');
 }catch(e){failures.push({key,error:e.message});}
}
console.log(JSON.stringify({repository_validators:['namespaceGap','messageArguments'],counts,failures},null,2));if(failures.length)process.exitCode=1;

