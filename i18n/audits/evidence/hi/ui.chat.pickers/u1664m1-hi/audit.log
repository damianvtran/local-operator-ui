import assert from 'node:assert/strict';
import {readFileSync} from 'node:fs';
import {createRequire} from 'node:module';
import {execFileSync} from 'node:child_process';
const root=process.argv[2]; const packet=process.argv[3];
const require=createRequire(`${root}/package.json`);
const {parse,TYPE}=require('@formatjs/icu-messageformat-parser');
const p=JSON.parse(readFileSync(`${packet}/hi.json`));
const {createHash}=require('node:crypto'); const hash=b=>createHash('sha256').update(b).digest('hex');
assert.equal(execFileSync('git',['-C',root,'rev-parse','HEAD'],{encoding:'utf8'}).trim(),p.frozen_merge_sha);
const data={};
for (const role of ['source','context','target']) {const d=p[role];const b=readFileSync(`${root}/${d.repo_relative_path}`);assert.equal(hash(b),d.sha256);assert.deepEqual(b,execFileSync('git',['-C',root,'show',`${p.frozen_merge_sha}:${d.repo_relative_path}`]));data[role]=JSON.parse(b);}
const en=data.source, hi=data.target, ctx=data.context;
assert.deepEqual(Object.keys(hi).sort(),Object.keys(en).sort());assert.deepEqual(Object.keys(ctx).sort(),Object.keys(en).sort());
const issues=[], inventory={keys:Object.keys(en).length,pluralNodes:0,selectNodes:0,tagNodes:0,backtickMessages:0,widthHints:0,deltaKeys:0};
const cats=new Intl.PluralRules('hi').resolvedOptions().pluralCategories;
function signature(nodes,locale,key) { const sig=[]; function walk(ns,path=''){for(const n of ns){if(n.type===TYPE.literal||n.type===TYPE.pound)continue;const item=[n.type,n.value];if(n.style)item.push(n.style);if(n.type===TYPE.tag){if(locale==='hi')inventory.tagNodes++;walk(n.children,path+'<'+n.value+'>');}if(n.options){const options=Object.keys(n.options).sort();item.push(options.filter(x=>!x.startsWith('=')),n.offset??0,n.pluralType??'');if(n.type===TYPE.plural&&locale==='hi'){inventory.pluralNodes++;const required=n.pluralType==='ordinal'?new Intl.PluralRules('hi',{type:'ordinal'}).resolvedOptions().pluralCategories:cats;for(const cat of required)if(!options.includes(cat))issues.push({key,kind:'missing_cldr',category:cat});}if(n.type===TYPE.select&&locale==='hi')inventory.selectNodes++;for(const [arm,opt]of Object.entries(n.options))walk(opt.value,path+'/'+n.value+':'+arm);}sig.push(JSON.stringify(item));}}walk(nodes);return [...new Set(sig)].sort();}
const delta=[...new Set(Object.values(p.parents).flatMap(v=>[...v.delta.added,...v.delta.changed]))].sort();inventory.deltaKeys=delta.length;
for(const key of Object.keys(en)){try{const a=signature(parse(en[key]),'en',key),b=signature(parse(hi[key]),'hi',key);if(JSON.stringify(a)!==JSON.stringify(b))issues.push({key,kind:'icu_signature'});}catch(e){issues.push({key,kind:'parse',error:e.message});}
const codes=s=>[...s.matchAll(/`[^`]*`/g)].map(m=>m[0]).sort();if(codes(en[key]).length)inventory.backtickMessages++;if(JSON.stringify(codes(en[key]))!==JSON.stringify(codes(hi[key])))issues.push({key,kind:'backtick_literal'});
for(const hint of ['maxChars','maxCells'])if(ctx[key][hint]!=null){inventory.widthHints++;if(hint==='maxChars'&&[...hi[key]].length>ctx[key][hint])issues.push({key,kind:'maxChars',actual:[...hi[key]].length,max:ctx[key][hint]});}
}
for(const [name,parent]of Object.entries(p.parents)){const prev=JSON.parse(execFileSync('git',['-C',root,'show',`${parent.commit}:${p.target.repo_relative_path}`]));const added=Object.keys(hi).filter(k=>!(k in prev)).sort(), removed=Object.keys(prev).filter(k=>!(k in hi)).sort(), changed=Object.keys(hi).filter(k=>k in prev&&hi[k]!==prev[k]).sort();assert.deepEqual({added,removed,changed},parent.delta);for(const key of parent.exact_retained_ids)assert.equal(hi[key],prev[key]);console.log('parent retention',name,JSON.stringify({added:added.length,changed:changed.length,removed:removed.length,exactRetained:parent.exact_retained_ids.length}));}
console.log(JSON.stringify({inventory,cldrCardinalCategories:cats,issues},null,2));
if(issues.length)process.exitCode=1;

