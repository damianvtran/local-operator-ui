 if(!same(e.styles,v.styles))failures.push([k,'number/date/time style mismatch']);
 if(!same(messageArguments(en[k]).sort(),messageArguments(vi[k]).sort()))failures.push([k,'repo messageArguments mismatch']);
 const code=s=>[...s.matchAll(/`[^`]*`/g)].map(x=>x[0]).sort();if(!same(code(en[k]),code(vi[k])))failures.push([k,'backtick code mismatch']);
 const commands=s=>[...s.matchAll(/(?<![\w/])\/[a-z][a-z0-9_-]*/g)].map(x=>x[0]).sort();if(!same(commands(en[k]),commands(vi[k])))failures.push([k,'slash command mismatch']);
