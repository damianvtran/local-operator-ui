 const old=JSON.parse(raw);const added=sortedKeys(vi).filter(k=>!(k in old));const removed=sortedKeys(old).filter(k=>!(k in vi));const changed=sortedKeys(vi).filter(k=>k in old&&old[k]!==vi[k]);const retained=sortedKeys(vi).filter(k=>old[k]===vi[k]);
 for(const [key,list]of Object.entries({added,removed,changed}))if(!same(list,[...v.delta[key]].sort()))throw Error(name+' delta mismatch '+key);
 if(!same(retained,[...v.exact_retained_ids].sort()))throw Error(name+' retained mismatch');for(const k of [...added,...changed])delta.add(k);parents[name]={added:added.length,removed:removed.length,changed:changed.length,retained:retained.length};
}
const failures=[],advisories=[],plurals=[]; let parsed=0;
function inspect(ast,where){const args=[],sels=[],tags=[],styles=[];function walk(nodes){for(const n of nodes){if([TYPE.argument,TYPE.number,TYPE.date,TYPE.time,TYPE.select,TYPE.plural].includes(n.type)) args.push([n.value,n.type]);if([TYPE.number,TYPE.date,TYPE.time].includes(n.type))styles.push([n.value,n.type,n.style??null]);if(n.type===TYPE.select)sels.push([n.value,sortedKeys(n.options)]);if(n.type===TYPE.tag){tags.push(n.value);walk(n.children);}if(n.type===TYPE.plural){const keys=sortedKeys(n.options);if(!keys.includes('other'))failures.push([where,'missing other']);if(where.startsWith('vi:')){plurals.push([where,keys]);const missing=new Intl.PluralRules('vi',{type:n.pluralType}).resolvedOptions().pluralCategories.filter(k=>!keys.includes(k));if(missing.length) failures.push([where,'CLDR missing',missing]);const extra=keys.filter(k=>!k.startsWith('=')&&k!=='other');if(extra.length)advisories.push([where,'pre-existing unused categories',extra]);}}for(const o of Object.values(n.options??{}))walk(o.value);}}walk(ast);return {args:[...new Set(args.map(JSON.stringify))].sort(),sels:sels.map(JSON.stringify).sort(),tags:tags.sort(),styles:[...new Set(styles.map(JSON.stringify))].sort()};}
for(const k of sortedKeys(en)){
 const ea=parse(en[k]),va=parse(vi[k]); parsed+=2;
 const e=inspect(ea,'en:'+k),v=inspect(va,'vi:'+k);
 if(!same(e.args,v.args))failures.push([k,'AST placeholder name/type mismatch',e.args,v.args]);
