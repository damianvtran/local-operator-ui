import fs from 'node:fs';
import assert from 'node:assert/strict';
import {parse, TYPE} from '@formatjs/icu-messageformat-parser';
const r='/Users/damian/local-operator-ui/.worktrees/i18n-four-flows';
const en=JSON.parse(fs.readFileSync(`${r}/src/i18n/catalogues/en/ui.chat.pickers.json`));
const ru=JSON.parse(fs.readFileSync(`${r}/src/i18n/catalogues/ru/ui.chat.pickers.json`));
const ctx=JSON.parse(fs.readFileSync(`${r}/src/i18n/catalogues/en/ui.chat.pickers.context.json`));
assert.deepEqual(Object.keys(en).sort(),Object.keys(ru).sort());
assert.deepEqual(Object.keys(en).sort(),Object.keys(ctx).sort());
let plurals=0,selects=0,tags=0; const problems=[];
function shape(nodes,locale,key){const sig=[];for(const n of nodes){
 if([TYPE.argument,TYPE.number,TYPE.date,TYPE.time].includes(n.type))sig.push(`${n.type}:${n.value}:${JSON.stringify(n.style??null)}`);
 if(n.type===TYPE.tag){if(locale==='ru')tags++;sig.push(`tag:${n.value}`,...shape(n.children,locale,key));}
 if(n.type===TYPE.select||n.type===TYPE.plural){
  sig.push(`${n.type}:${n.value}:${n.pluralType??''}:${n.offset??0}`);
  if(n.type===TYPE.plural){if(locale==='ru')plurals++;const need=new Intl.PluralRules(locale,{type:n.pluralType}).resolvedOptions().pluralCategories;for(const arm of need)if(locale==='ru' && !n.options[arm])problems.push(`${key}:${locale}:missing ${arm}`);}
  else {if(locale==='ru')selects++;sig.push(`selectarms:${Object.keys(n.options).sort().join(',')}`);}
  for(const [arm,opt] of Object.entries(n.options)){if(arm.startsWith('=') && locale==='en' && !ru[key].includes(`${arm} {`))problems.push(`${key}:missing source exact arm ${arm}`);sig.push(...shape(opt.value,locale,key));}
 }
}return [...new Set(sig)].sort();}
for(const k of Object.keys(en)){
 assert.deepEqual(shape(parse(en[k]),'en',k),shape(parse(ru[k]),'ru',k),`typed ICU/tag shape ${k}`);
 for(const re of [/`[^`]*`/g,/(?<![\w/])--[a-z][\w-]*/g,/(?<![\w/])\/[a-z][a-z0-9_-]*/g]){
 const tok=s=>[...s.matchAll(re)].map(x=>x[0]).sort();assert.deepEqual(tok(en[k]),tok(ru[k]),`literal tokens ${k}`);}
 assert.equal(ru[k],ru[k].normalize('NFC'),`NFC ${k}`);
 assert.ok(!/[\u202a-\u202e\u2066-\u2069]/.test(ru[k]),`bidi ${k}`);
}
assert.deepEqual(problems,[]);
console.log(JSON.stringify({status:'PASS',key_count:Object.keys(en).length,ru_plural_nodes:plurals,ru_select_nodes:selects,ru_rich_tag_nodes:tags,checks:['key/context parity','typed ICU/tag shape','CLDR categories','exact plural arms','select arms','backticks','flags','slash commands','NFC','no manual bidi controls']},null,2));

