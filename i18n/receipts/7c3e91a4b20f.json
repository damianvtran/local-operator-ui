      "findings": [
        {
          "severity": "NIT",
          "key": "ui.common.updates.update_notification.failure_consequence_nothing_restarted",
          "issue": "\"没有重启任何内容\" reads a little literally. \"未重启任何服务。\" would name what was not restarted more naturally. The meaning is right."
        },
        {
          "severity": "NIT",
          "key": "ui.common.updates.update_notification.failure_cause_serve",
          "issue": "\"仍在运行{version}\" puts a bare version number such as 0.88.4 straight after the verb. \"仍在运行版本{version}\" reads more clearly and matches failure_cause_publication (\"版本{target}\"). The {version} placeholder is kept correctly."
        },
        {
          "severity": "NIT",
          "key": "ui.common.updates.update_notification.failure_remedy_ownership",
          "issue": "\"请登录拥有此安装的账户\" is acceptable. \"请以拥有此安装的账户登录\" is closer to \"sign in as\". \"如果无法登录\" makes \"if you cannot\" slightly narrower but keeps the route. Not blocking."
        }
      ]
